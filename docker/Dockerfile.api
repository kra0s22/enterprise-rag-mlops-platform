# Serving + ingestion image: core deps only (evaluation stack is optional).
# The base image is pinned to a digest so upstream changes cannot silently pull
# in new CVEs; bump the pin explicitly and rebuild to update the base.
FROM python:3.11-slim@sha256:1042b61448fef4ba92d16a8c7eb4996d027568ce64792a7877fd88511e0af7c6 AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# Install the package first for better layer caching.
COPY pyproject.toml README.md ./
COPY src ./src
# sentence-transformers pulls the CUDA build of torch on Linux by default;
# install the CPU wheel so the serving image stays small and builds fast.
RUN pip install --upgrade pip && \
    pip install --index-url https://download.pytorch.org/whl/cpu torch && \
    pip install .

# PySpark (a core dependency) needs a JVM for `rag-ingest --distributed`.
# python:3.11-slim is Debian trixie, which only ships OpenJDK 21.
RUN apt-get update && apt-get install -y --no-install-recommends openjdk-21-jre-headless \
    && rm -rf /var/lib/apt/lists/*

EXPOSE 8000

CMD ["rag-api"]
