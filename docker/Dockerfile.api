# Lean serving image: core deps only (evaluation stack is optional).
FROM python:3.11-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# Install the package first for better layer caching.
COPY pyproject.toml README.md ./
COPY src ./src
# sentence-transformers pulls the CUDA build of torch on Linux by default;
# install the CPU wheel so the serving image stays small and builds fast.
RUN pip install --upgrade pip && \
    pip install --index-url https://download.pytorch.org/whl/cpu torch && \
    pip install .

EXPOSE 8000

CMD ["rag-api"]
