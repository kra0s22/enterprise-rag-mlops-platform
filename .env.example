# Application
RAG_APP_NAME=rag-platform
RAG_ENVIRONMENT=development
RAG_LOG_LEVEL=INFO

# Embeddings (local / OSS)
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_EMBEDDING_DEVICE=cpu
RAG_EMBEDDING_BATCH_SIZE=32
RAG_EMBEDDING_DIMENSION=384

# Chunking
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64
RAG_CHUNK_MODE=window   # "window" (token) or "semantic" (structure-aware)

# Vector store backend (qdrant | milvus)
RAG_VECTOR_STORE_PROVIDER=qdrant

# Qdrant
RAG_QDRANT_URL=http://localhost:6333
RAG_QDRANT_COLLECTION=documents
RAG_QDRANT_API_KEY=

# Milvus
RAG_MILVUS_URI=http://localhost:19530
RAG_MILVUS_COLLECTION=documents
RAG_MILVUS_TOKEN=

# Search
RAG_DEFAULT_TOP_K=5
RAG_SCORE_THRESHOLD=0.0
# Multi-tenancy: default tenant used to tag ingested chunks and scope retrieval
RAG_TENANT=default

# Generation (Ollama)
RAG_OLLAMA_URL=http://localhost:11434
RAG_LLM_MODEL=llama3.2:3b
RAG_LLM_TEMPERATURE=0.2
RAG_LLM_MAX_TOKENS=512

# MLflow
RAG_MLFLOW_TRACKING_URI=http://localhost:5000
RAG_MLFLOW_EXPERIMENT_NAME=rag_platform

# API
RAG_API_HOST=0.0.0.0
RAG_API_PORT=8000
RAG_API_KEY=                 # when set, /v1/* requires the X-API-Key header
RAG_RATE_LIMIT_PER_MINUTE=60  # per-client requests allowed each minute
